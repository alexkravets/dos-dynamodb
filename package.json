{
  "name": "@kravc/dos-dynamodb",
  "version": "1.0.0-alpha.6",
  "private": true,
  "description": "CRUD interface for DynamoDB table to be used with @kravc/dos service.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/slatstudio/dos-dynamodb.git"
  },
  "directories": {
    "src": "src"
  },
  "scripts": {
    "test": "eslint --fix src/ example/ && npm run db:up && sleep 2 && jest --coverage",
    "prebuild": "rimraf dist",
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "db:up": "docker compose --project-name dos -f ./docker-compose.yaml up -d"
  },
  "bin": {
    "table": "bin/table.js"
  },
  "author": "Oleksandr Kravets <alex@slatestudio.com>",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.995.0",
    "@aws-sdk/credential-providers": "^3.995.0",
    "@aws-sdk/lib-dynamodb": "^3.995.0",
    "@kravc/dos": "^2.0.0-alpha.14",
    "config": "^4.4.0",
    "hashids": "^2.3.0",
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/config": "^3.3.5",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "eslint": "^10.0.1",
    "eslint-plugin-jsdoc": "^62.7.0",
    "globals": "^17.3.0",
    "jest": "^30.2.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
